# Security headers for Cloudflare Pages.
#
# The Content Security Policy deliberately lives in a <meta> tag inside each
# page rather than here. Cloudflare merges every matching rule in this file
# instead of overriding, so a path-specific rule cannot relax a site-wide
# one: the browser enforces the intersection and the strictest policy wins.
# A per-page meta tag is the only way to have a strict policy everywhere and
# a slightly looser one on the editor, which needs Google's sign-in script.
#
# Consequence: every page must carry its own CSP meta tag. If you add a page,
# copy the meta block from a sibling.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups

# Assets are cached briefly rather than immutably. There is no build step to
# hash filenames, so freshness is handled by version queries (hk.js?v=26) and
# this ceiling is the safety net: if a version is ever forgotten, the file
# refreshes within ten minutes instead of sitting in a browser for a year.
#
# Do not add a more specific /assets/... rule here. Cloudflare concatenates
# overlapping rules into a single malformed Cache-Control header rather than
# letting the specific one win, which is exactly how the CSP was broken once
# already.
/assets/*
  Cache-Control: public, max-age=600, must-revalidate

# none of these pages may be rewritten at the edge.
#
# Cloudflare can inject its analytics beacon into HTML as it passes through.
# The privacy page promises no third-party tracking scripts, and a Content
# Security Policy of script-src 'self' blocks the beacon, so the promise held
# only because the browser refused the script - which also meant a console
# error on every page. no-transform refuses the rewrite outright instead, so
# nothing can be added to a page whatever is switched on in the dashboard.
#
# The pages are listed one by one because a /* rule would overlap the /assets/
# rule above and be concatenated into it. A URL that matches nothing here (a
# 404, for instance) keeps the platform default. Pages served by a Function
# set their own headers, so /blog-post carries this in its own code.
/index.html
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/knowledge
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/advice
  Cache-Control: public, max-age=0, must-revalidate, no-transform
